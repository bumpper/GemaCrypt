{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GemaCrypt",
  "version": "0.0.1",
  "identifier": "com.bumpper.gemacrypt",
  "build": {
    "frontendDist": "src",
    "devUrl": "http://127.0.0.1:8000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../scripts/copy-php.js"
  },
  "app": {
    "windows": [
      {
        "title": "GemaCrypt",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
